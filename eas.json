{
  "cli": {
    "version": ">= 16.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "autoIncrement": true },
      "android": { "autoIncrement": true }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "ios": { "autoIncrement": true },
      "android": { "autoIncrement": true }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "ios": { "autoIncrement": true },
      "android": { "autoIncrement": true }
    }
  },
  "submit": {
    "preview": { "ios": {} },
    "production": { "ios": {} }
  }
}
