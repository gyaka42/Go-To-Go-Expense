rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function walletDoc(walletId) {
      return get(/databases/$(database)/documents/wallets/$(walletId));
    }

    function walletHasUidData(w, uid) {
      return uid != null && (
        (w.ownerIds is list && w.ownerIds.hasAny([uid])) ||
        (w.memberIds is list && w.memberIds.hasAny([uid])) ||
        (w.participantIds is list && w.participantIds.hasAny([uid])) ||
        w.uid == uid
      );
    }

    function isWalletOwnerData(w, uid) {
      return uid != null && (
        (w.ownerIds is list && w.ownerIds.hasAny([uid])) ||
        w.uid == uid
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /users/{userId}/rules/{ruleDocId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /wallets/{walletId} {
      allow read: if isSignedIn() && walletHasUidData(resource.data, request.auth.uid);

      allow create: if isSignedIn();

      allow update: if isSignedIn() && isWalletOwnerData(resource.data, request.auth.uid);

      allow delete: if isSignedIn() && isWalletOwnerData(resource.data, request.auth.uid);

      match /transactions/{transactionId} {
        allow read: if isSignedIn() && walletHasUidData(walletDoc(walletId).data, request.auth.uid);

        allow create: if isSignedIn() && walletHasUidData(walletDoc(walletId).data, request.auth.uid);

        allow update: if isSignedIn() && isWalletOwnerData(walletDoc(walletId).data, request.auth.uid);

        allow delete: if isSignedIn() && isWalletOwnerData(walletDoc(walletId).data, request.auth.uid);
      }

      match /activity/{activityId} {
        allow read: if isSignedIn() && walletHasUidData(walletDoc(walletId).data, request.auth.uid);
        allow create: if isSignedIn() && walletHasUidData(walletDoc(walletId).data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /emailDirectory/{emailKey} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Top-level transactions (used by home feed & searches)
    match /transactions/{transactionId} {
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        (request.resource.data.walletId is string &&
          walletHasUidData(walletDoc(request.resource.data.walletId).data, request.auth.uid))
      );

      allow read, update, delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        (resource.data.walletId is string &&
          walletHasUidData(walletDoc(resource.data.walletId).data, request.auth.uid))
      );
    }
  }
}
